# Copy this file to .env.local and fill in the real token.
# .env.local is gitignored — never commit real credentials.

# Required: GitHub Personal Access Token (Fine-grained) with
#   Repository permissions → Contents: Read and write
# scoped to the thetai161/mkt-lunch repo.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides (sensible defaults in api/data.js):
# GITHUB_OWNER=thetai161
# GITHUB_REPO=mkt-lunch
# GITHUB_BRANCH=data
# GITHUB_DATA_PATH=data.json
# GIT_COMMITTER_NAME=Team Lunch Bot
# GIT_COMMITTER_EMAIL=bot@mkt-lunch.local
